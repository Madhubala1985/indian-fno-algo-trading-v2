# Real-armed interlock profile — BACKSTOPS ONLY (parity directive 2026-07-05).
#
# real_armed runs the EXACT same profile as the validated paper/dry-run
# sessions: 8% risk, pure %-of-capital sizing (no lot ceilings), 15%
# single-position premium cap, 30% heat, 14%/15% daily halts. These interlocks
# do NOT size or derate trades — they are absolute rupee rails that mirror the
# profile's own fraction caps at the funded capital, so a sizing BUG (never a
# normal trade) hits a hard wall. Values below assume ₹2.5L funded capital —
# scale them proportionally to the actual funded amount.
#
# Copy to a private file (never commit the copy), then source before launch:
#   set -a; source configs/real_armed_interlocks.env; set +a
#   PYTHONPATH=. python scripts/run_supervised_live_session.py --execution-mode real_armed
#
# ALL NINE must be set or the broker adapter fail-closes before any order.
# Cap VALUES are enforced (validate_real_order_caps + the pipeline rupee-cap
# gate). Caps block ENTRIES only; exits are never blocked.

# ── Intent confirmation (exact values required) ──────────────────────────────
REAL_TRADING_ENABLED=true
REAL_TRADING_CONFIRMATION=I_UNDERSTAND_REAL_MONEY_RISK
BROKER_LIVE_ORDERS_ALLOWED=true

# ── Rupee backstops (mirror the profile's fraction rails at funded capital) ──
# Total premium outlay ceiling = the funded amount (you cannot deploy money
# that isn't there; the 30% heat cap binds long before this).
MAX_REAL_CAPITAL=250000
# Entries stop for the day at the 15% hard daily halt's rupee equivalent
# (the profile's own PAPER_HARD_HALT_DAILY_LOSS=0.15 fires at the same level).
MAX_REAL_DAILY_LOSS=37500
# Single-order premium ceiling = the 15% single-position premium cap's rupee
# equivalent (PAPER_MAX_POSITION_PREMIUM_FRAC) — the sizer respects the
# fraction; this is the absolute wall behind it.
MAX_REAL_ORDER_VALUE=40000
# Exchange freeze-quantity scale (NIFTY 1800 qty = 24 lots; SENSEX freeze is
# higher). The sizer's freeze-qty rail keeps orders below this on its own —
# this only catches a runaway-lots bug.
REAL_MAX_LOTS_PER_ORDER=24

# ── Scope ─────────────────────────────────────────────────────────────────────
REAL_ALLOWED_UNDERLYINGS=SENSEX,NIFTY
REAL_ALLOWED_EXCHANGES=BFO,NFO
