# Real-armed interlock profile — FIRST ARMED WEEK (canary sizing).
# Copy to a private file (never commit the copy), adjust MAX_REAL_CAPITAL to the
# actual funded amount, then source it in the shell that launches the supervisor:
#   set -a; source configs/real_armed_interlocks.env; set +a
#   PYTHONPATH=. python scripts/run_supervised_live_session.py --execution-mode real_armed
#
# ALL NINE must be set or the broker adapter fail-closes before any order.
# As of 2026-07-05 the cap VALUES are enforced too (validate_real_order_caps +
# the pipeline's rupee-cap entry gate) — before that they were only
# required-to-be-set. Caps block ENTRIES only; exits are never blocked.

# ── Intent confirmation (exact values required) ──────────────────────────────
REAL_TRADING_ENABLED=true
REAL_TRADING_CONFIRMATION=I_UNDERSTAND_REAL_MONEY_RISK
BROKER_LIVE_ORDERS_ALLOWED=true

# ── Rupee caps (enforced at entry in the live pipeline) ──────────────────────
# Total premium outlay may never exceed this (set to the funded amount).
MAX_REAL_CAPITAL=250000
# Entries stop for the day once realised daily loss reaches this (3% of 2.5L).
MAX_REAL_DAILY_LOSS=7500

# ── Per-order caps (enforced in the broker adapter, BUY only) ────────────────
# Single order premium value ceiling (~15% of capital, the tail-defense cap).
MAX_REAL_ORDER_VALUE=40000
# Canary sizing for the first armed week: max 2 lots per order regardless of
# what the sizer wants. Raise only after a full clean armed week.
REAL_MAX_LOTS_PER_ORDER=2

# ── Scope (enforced in the broker adapter, BUY only) ─────────────────────────
REAL_ALLOWED_UNDERLYINGS=SENSEX,NIFTY
REAL_ALLOWED_EXCHANGES=BFO,NFO
